load(
    "//:build_defs.bzl",
    "mozc_cc_library",
    "mozc_cc_test",
    "mozc_select",
)

package(default_visibility = ["//visibility:public"])

exports_files([
    "chardata.bin",
    "dummy_model.bin",
])

mozc_cc_library(
    name = "charindex",
    srcs = ["charindex.cc"],
    hdrs = ["charindex.hh"],
)

mozc_cc_library(
    name = "gru_scorer",
    srcs = [
        "gpu_backend.cc",
        "gru_model.cc",
    ],
    hdrs = [
        "gpu_backend.hh",
        "gru_model.hh",
        "math_ops.hh",
    ],
    linkopts = mozc_select(
        default = [],
        linux = ["-ldl"],
    ),
    deps = [
        ":charindex",
    ],
)

mozc_cc_test(
    name = "gru_scorer_test",
    size = "small",
    srcs = ["gru_scorer_test.cc"],
    data = [
        "chardata.bin",
        "dummy_model.bin",
    ],
    deps = [
        ":charindex",
        ":gru_scorer",
    ],
)
